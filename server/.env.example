# Server Environment Configuration Template
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/campusos?appName=CampusOS
JWT_SECRET=your_jwt_secret_key_here
USE_MEMORY_DB=false

# Transactional Email Service (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_123456789_your_api_key_here
EMAIL_FROM=CampusOS <onboarding@resend.dev>
